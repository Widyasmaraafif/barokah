APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Barokah marketplace (non-secret defaults; DB settings win at runtime) ---
MARKETPLACE_NAME="Barokah"
MARKETPLACE_TAGLINE="Barokah Multi-Seller Marketplace"
MARKETPLACE_CURRENCY_CODE=MYR
MARKETPLACE_CURRENCY_SYMBOL=RM

# --- Checkout ---
CHECKOUT_ORDER_EXPIRATION_MINUTES=30

# --- Shipping (Fixed Rate active; external provider TBC spec §24 item 2) ---
SHIPPING_METHOD=fixed
SHIPPING_FIXED_RATE=5.00
SHIPPING_FREE_ENABLED=false
SHIPPING_FREE_THRESHOLD=100.00
# TBC_SHIPPING_*: external provider unresolved — leave empty until confirmed.
TBC_SHIPPING_PROVIDER_NAME=
TBC_SHIPPING_API_ENABLED=false
TBC_SHIPPING_API_BASE_URL=
TBC_SHIPPING_API_KEY=
TBC_SHIPPING_API_SECRET=
TBC_SHIPPING_TIMEOUT_SECONDS=10

# --- PayNet FPX/DuitNow (TBC spec §24 item 1 / §15.6: all values placeholder) ---
# TBC_PAYNET_*: real base URL, auth, payload shapes, signature algorithm,
# redirect vs QR, and sandbox/prod credentials unresolved. Never expose to frontend.
TBC_PAYNET_API_BASE=
TBC_PAYNET_MERCHANT_ID=
TBC_PAYNET_SECRET=
PAYNET_BASE_URL="${TBC_PAYNET_API_BASE}"
PAYNET_MERCHANT_ID="${TBC_PAYNET_MERCHANT_ID}"
PAYNET_SECRET="${TBC_PAYNET_SECRET}"
PAYNET_SANDBOX=true
PAYNET_TIMEOUT=15

# --- Queue / Scheduler (production) ---
# QUEUE_CONNECTION=database by default above. Run a worker:
#   php artisan queue:work --tries=3 --backoff=60
# Scheduler (order expiry `orders:expire-pending` every minute) requires cron:
#   * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
# Storage: run `php artisan storage:link` on each deploy/release.
